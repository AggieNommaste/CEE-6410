PROFIT..  - 6000*X(Coup) - 7000*X(Minivan) + VPROFIT =E= 0 ; (LHS = 0)
     

---- RES_CONSTRAIN  =L=  Resource Constraints

RES_CONSTRAIN(Metal)..  1000*X(Coup) + 2000*X(Minivan) =L= 4000000 ; (LHS = 0)
     
RES_CONSTRAIN(CircuitBoards)..  4*X(Coup) + 3*X(Minivan) =L= 12000 ; (LHS = 0)
     
RES_CONSTRAIN(Labor)..  5*X(Coup) + 2.5*X(Minivan) =L= 17500 ; (LHS = 0)
     
